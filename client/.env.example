# API Backend URL
VITE_API_URL=http://localhost:4000/api

# Google Analytics / PostHog (if applicable)
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=https://us.i.posthog.com

# Google AdSense Configuration
# Replace with your approved Google AdSense publisher ID (e.g. ca-pub-1234567890123456)
VITE_GOOGLE_ADSENSE_PUBLISHER_ID=ca-pub-XXXXXXXXXXXXXXXX

# Master switch to enable/disable ads (default: true)
VITE_ENABLE_ADS=true

# Optional Individual Ad Slot IDs (generated from Google AdSense Dashboard -> Ads -> By ad unit)
VITE_ADSENSE_SLOT_HOME_BANNER=
VITE_ADSENSE_SLOT_EXAM_BANNER=
VITE_ADSENSE_SLOT_PREDICTOR_RESULTS=
VITE_ADSENSE_SLOT_MOCK_COUNSELLING=
