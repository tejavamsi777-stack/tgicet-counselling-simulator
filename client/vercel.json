{
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "vuelalearn.vercel.app"
        }
      ],
      "destination": "https://vuelalearn.in/:path*",
      "permanent": true
    }
  ],
  "rewrites": [
    { "source": "/ads.txt", "destination": "/ads.txt" },
    { "source": "/googleec4a8053e053fe91.html", "destination": "/googleec4a8053e053fe91.html" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}